.switch { position: relative; display: inline-block; width: 50px; height: 24px; }
.switch input { opacity: 0; width: 0; height: 0; }
.slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #333; transition: .4s; border-radius: 34px; }
.slider:before { position: absolute; content: ""; height: 18px; width: 18px; left: 4px; bottom: 3px; background-color: white; transition: .4s; border-radius: 50%; }
input:checked + .slider { background-color: #6d7cff; }
input:checked + .slider:before { transform: translateX(26px); }

/* ✨ GLASSMORPHISM MODE ✨ */
body.glass-mode {
    background: linear-gradient(135deg, #0f0c29, #302b63, #24243e) !important;
}

body.glass-mode .card, 
body.glass-mode .qr-container, 
body.glass-mode .product-item {
    background: rgba(255, 255, 255, 0.05) !important; /* Transparent white */
    backdrop-filter: blur(15px) !important;           /* Blur effect */
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37) !important;
}

body.glass-mode button:not(.qr-close) {
    background: rgba(109, 124, 255, 0.2) !important;
    border: 1px solid rgba(255, 255, 255, 0.2) !important;
    backdrop-filter: blur(5px);
}



